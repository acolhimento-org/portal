---
import Icon from './Icon.astro';
import { KINDS } from '../lib/data';
const { service, featured = false } = Astro.props;
const meta = KINDS[service.kind];
const schedule = service.schedule ?? [];
const family = service.audience === 'familia';
const tone = family ? 'family' : ['na', 'aa'].includes(service.kind) ? 'support' : 'sus';
---
<article
  class={`svc tone-${tone} ${featured ? 'featured' : ''}`}
  data-kind={service.kind}
  data-neighborhood={service.neighborhood ?? ''}
  data-id={service.id}
  data-name={service.name}
  data-lat={service.lat ?? ''}
  data-lng={service.lng ?? ''}
  data-open24h={service.open_24h ? '1' : ''}
>
  <div class="svc-icon" aria-hidden="true">
    <Icon kind={service.kind} size={22} />
  </div>

  <div class="svc-body">
    <h3><a href={`/servico/${service.id}/`}>{service.name}</a></h3>

    <p class="svc-where">
      {service.address
        ? <>{service.address}{service.neighborhood ? <> · <span class="nb">{service.neighborhood}</span></> : null}</>
        : <>{service.city}/{service.state}{service.online ? ' · reunião online' : ''}</>}
    </p>

    {service.hours && (
      <p class="svc-hours">
        {service.open_24h
          ? <span class="h24">Aberto 24 horas, todos os dias</span>
          : <>Horário: {service.hours}</>}
      </p>
    )}

    {schedule.length > 0 && (
      <p class="svc-when">
        {schedule.slice(0, 3).map((s: any) => (
          <span class="slot">{s.weekday} {s.time}</span>
        ))}
        {schedule.length > 3 && <span class="more">+{schedule.length - 3}</span>}
      </p>
    )}

    <p class="svc-actions">
      {service.phones?.length > 0 && (
        <a class="tel" href={`tel:${service.phones[0].replace(/\D/g, '')}`}>
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1l-2.23 2.2z" fill="currentColor"/>
          </svg>
          {service.phones[0]}
        </a>
      )}
      <span class="free">
        <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Grátis
      </span>
      {featured && <span class="tag">Especializado em álcool e drogas</span>}
      {service.open_meeting === true && <span class="tag tag-open">Familiares bem-vindos</span>}
      {service.open_meeting === false && <span class="tag tag-closed">Somente dependentes</span>}
      {service.wheelchair && <span class="tag">Acesso a cadeirantes</span>}
    </p>
  </div>
</article>

<style>
  .svc {
    display: flex; gap: var(--s4); align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: var(--s5);
    box-shadow: var(--shadow);
  }
  .svc.featured { border-color: var(--primary); border-left-width: 4px; }

  .svc-icon {
    width: 44px; height: 44px; flex: none;
    display: grid; place-items: center; border-radius: 50%;
  }
  .tone-sus .svc-icon { background: var(--primary-soft); color: var(--primary-ink); }
  .tone-support .svc-icon { background: var(--support-soft); color: var(--support); }
  .tone-family .svc-icon { background: var(--family-soft); color: var(--family); }

  .svc-body { min-width: 0; flex: 1; }
  h3 { font-size: 1.02rem; line-height: 1.3; margin-bottom: var(--s1); }
  h3 a { text-decoration: none; color: var(--ink); }
  h3 a:hover { text-decoration: underline; }

  .svc-where { color: var(--ink-soft); font-size: .9rem; margin: 0 0 var(--s2); }
  .nb { white-space: nowrap; }

  .svc-hours { font-size: .85rem; color: var(--ink-soft); margin: 0 0 var(--s2); }
  .h24 {
    font-weight: 700; color: var(--accent-ink);
    background: var(--accent-soft); border-radius: 100px; padding: 2px 10px;
    font-size: .78rem; letter-spacing: .01em;
  }
  .svc-when { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s2); margin: 0 0 var(--s2); }
  .slot {
    font-size: .76rem; font-variant-numeric: tabular-nums;
    background: var(--surface-2); color: var(--ink-soft);
    border-radius: 100px; padding: 1px 9px;
  }
  .more { font-size: .78rem; color: var(--ink-soft); align-self: center; }

  .svc-actions {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s3);
    margin: 0;
  }
  .tel {
    display: inline-flex; align-items: center; gap: var(--s1);
    font-weight: 600; font-size: .9rem; text-decoration: none;
    padding: var(--s1) 0; min-height: 32px;
  }
  .tel:hover { text-decoration: underline; }
  .free {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: .75rem; font-weight: 700; letter-spacing: .02em;
    color: var(--primary-ink);
  }
  .tag {
    font-size: .7rem; font-weight: 600; color: var(--accent-ink);
    background: var(--accent-soft); border-radius: 100px; padding: 3px 10px;
  }
  .tag-open { color: var(--primary-ink); background: var(--primary-soft); }
  .tag-closed { color: var(--ink-soft); background: var(--surface-2); }
</style>
