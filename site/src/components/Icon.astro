---
// Ícones funcionais por tipo de serviço, em SVG inline (zero requisições).
// A forma distingue a natureza do serviço; a cor reforça:
//   cruz = saúde/SUS · roda de pessoas = grupo de mútua ajuda · coração+pessoas = família
interface Props {
  kind: string;
  size?: number;
  class?: string;
}
const { kind, size = 24, class: klass = '' } = Astro.props;

const paths: Record<string, string> = {
  // Cruz médica preenchida: serviço especializado (CAPS AD)
  caps_ad: '<path d="M9.5 3h5a1.5 1.5 0 0 1 1.5 1.5V8h3.5A1.5 1.5 0 0 1 21 9.5v5a1.5 1.5 0 0 1-1.5 1.5H16v3.5a1.5 1.5 0 0 1-1.5 1.5h-5A1.5 1.5 0 0 1 8 19.5V16H4.5A1.5 1.5 0 0 1 3 14.5v-5A1.5 1.5 0 0 1 4.5 8H8V4.5A1.5 1.5 0 0 1 9.5 3z" fill="currentColor"/>',
  // Cruz vazada: serviço de saúde mental geral (CAPS)
  caps: '<path d="M9.5 3.75h5a.75.75 0 0 1 .75.75v4.25h4.25a.75.75 0 0 1 .75.75v5a.75.75 0 0 1-.75.75H15.25v4.25a.75.75 0 0 1-.75.75h-5a.75.75 0 0 1-.75-.75V15.25H4.5a.75.75 0 0 1-.75-.75v-5a.75.75 0 0 1 .75-.75h4.25V4.5a.75.75 0 0 1 .75-.75z" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  // Prédio: outros serviços da RAPS
  raps_outro: '<path d="M4 21V6.5a1 1 0 0 1 .6-.92l7-3a1 1 0 0 1 .8 0l7 3a1 1 0 0 1 .6.92V21M4 21h16M9 21v-4.5h6V21M8.5 10h1.5M14 10h1.5M8.5 13.5H10M14 13.5h1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  // Roda de pessoas: grupo de mútua ajuda (NA)
  na: '<circle cx="12" cy="6" r="2.4" fill="currentColor"/><circle cx="18" cy="15.5" r="2.4" fill="currentColor"/><circle cx="6" cy="15.5" r="2.4" fill="currentColor"/><path d="M12 9.6a6.6 6.6 0 0 1 4.2 2.6M9.4 15.5h5.2M7.8 12.2A6.6 6.6 0 0 1 12 9.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  // Roda de pessoas: AA (mesma família visual do NA)
  aa: '<circle cx="12" cy="6" r="2.4" fill="currentColor"/><circle cx="18" cy="15.5" r="2.4" fill="currentColor"/><circle cx="6" cy="15.5" r="2.4" fill="currentColor"/><path d="M12 9.6a6.6 6.6 0 0 1 4.2 2.6M9.4 15.5h5.2M7.8 12.2A6.6 6.6 0 0 1 12 9.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  // Coração acolhendo: familiares (Al-Anon)
  alanon: '<path d="M12 20.5c-4.2-3-7-5.6-7-8.8A3.9 3.9 0 0 1 8.8 7.8c1.3 0 2.5.7 3.2 1.8.7-1.1 1.9-1.8 3.2-1.8A3.9 3.9 0 0 1 19 11.7c0 3.2-2.8 5.8-7 8.8z" fill="currentColor"/><circle cx="7.2" cy="4.6" r="1.5" fill="currentColor" opacity=".55"/><circle cx="16.8" cy="4.6" r="1.5" fill="currentColor" opacity=".55"/>',
};
---
<svg
  class={`icon ${klass}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={paths[kind] ?? paths.raps_outro}
/>
<style>
  .icon { flex: none; display: block; }
</style>
